{
  "name": "isolator",
  "version": "1.2.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w api\" \"npm run dev -w web\"",
    "dev:api": "npm run dev -w api",
    "dev:web": "npm run dev -w web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "npm run db:generate -w api",
    "db:migrate": "npm run db:migrate -w api",
    "db:seed": "npm run db:seed -w api",
    "db:seed:dev": "npm run db:seed:dev -w api",
    "db:studio": "npm run db:studio -w api",
    "release": "wersion",
    "create-docker-image": "node scripts/create-and-push-image.mts"
  },
  "devDependencies": {
    "@weichwarenprojekt/wersion": "1.7.0",
    "concurrently": "^10.0.6"
  }
}
