DATABASE_URL=postgres://isolator:isolator@localhost:5440/isolator
PORT=3000

# Sign-in. Fill these in with `npx clerk@latest env pull --file apps/api/.env`.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# The address people open Isolator at. Sign-ins made anywhere else are refused. Without it the
# API starts in development and refuses to in production.
# APP_URL=http://localhost:5173

# File storage. Files go to STORAGE_DIR unless S3_BUCKET is set.
# STORAGE_DIR=./storage
# S3_BUCKET=isolator
# S3_REGION=eu-central-1
# For an S3-compatible service such as Hetzner Object Storage or MinIO:
# S3_ENDPOINT=https://fsn1.your-objectstorage.com
# S3_FORCE_PATH_STYLE=true
# Leave these out to use the SDK's own credentials, such as an instance role:
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Virus scanning. Uploads are scanned when CLAMAV_HOST is set, and refused if it can't be reached.
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3310
