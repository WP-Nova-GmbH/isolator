DATABASE_URL=postgres://isolator:isolator@localhost:5440/isolator
PORT=3000

# Sign-in. The address people open Isolator at, and a secret of at least 32 characters
# (`openssl rand -hex 32`). Without a secret the API starts in development and refuses to in
# production. Changing the secret signs everyone out.
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_SECRET=

# File storage. Files go to STORAGE_DIR unless S3_BUCKET is set.
# STORAGE_DIR=./storage
# S3_BUCKET=isolator
# S3_REGION=eu-central-1
# For an S3-compatible service such as Hetzner Object Storage or MinIO:
# S3_ENDPOINT=https://fsn1.your-objectstorage.com
# S3_FORCE_PATH_STYLE=true
# Leave these out to use the SDK's own credentials, such as an instance role:
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Virus scanning. Uploads are scanned when CLAMAV_HOST is set, and refused if it can't be reached.
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3310
